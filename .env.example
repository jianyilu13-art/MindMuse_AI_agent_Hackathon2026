# Choose the AI provider: bedrock or groq.
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_DEFAULT_REGION=us-east-1

# AWS temporary credentials should come from the AWS CLI environment or profile,
# not from this file. They expire and should never be committed.

# Only needed when LLM_PROVIDER=groq.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=


# Product search: use mock for a local smoke test, or searchapi for live results.
SHOPPING_TOOL_MODE=searchapi
# Get a key at https://www.searchapi.io (free trial credits).
SEARCHAPI_API_KEY=
SEARCHAPI_GL=sg
SEARCHAPI_HL=en
SEARCHAPI_FORUM_TOP_K=1
# Process-local cache and bounded forum lookup controls.
SEARCHAPI_MAX_PRODUCTS=12
