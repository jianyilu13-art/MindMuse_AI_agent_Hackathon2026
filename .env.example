# Copy this file to `.env` and fill in your key to enable live Google Shopping.
# `.env` is git-ignored — never commit your real key.
#
#   cp .env.example .env
#
# Get a key at https://www.searchapi.io (free trial credits).
SEARCHAPI_API_KEY=

# Optional: enables the LLM agent (reasoning, dynamic questions, semantic screening).
# Without it the agent still runs on deterministic rules.
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
