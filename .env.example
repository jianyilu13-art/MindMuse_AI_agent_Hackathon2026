# Get a key from https://console.groq.com/keys
GROQ_API_KEY=
# Use mock tools locally (default). Set to real when platform adapters are implemented.
SHOPPING_TOOL_MODE=mock
# Alias accepted for compatibility with deployment environments.
# SHOPPING_PLATFORM=mock
# Optional override for the Groq model.
GROQ_MODEL=llama-3.3-70b-versatile

SHOPEE_API_KEY=
SHOPEE_BASE_URL=

LAZADA_API_KEY=
LAZADA_BASE_URL=

AMAZON_API_KEY=
AMAZON_BASE_URL=

EBAY_API_KEY=
EBAY_BASE_URL=
